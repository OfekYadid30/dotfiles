#!/usr/bin/env python3
"""git mlogf [--branch BRANCH]

Like `git mlog`, but lists the files changed in each commit (git log
--stat) right after that commit's line. Equivalent to `git mlog --stat`,
kept as its own command since that's what a lot of muscle memory expects.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from gitm.cli import add_branch_args, run_main
from gitm.mlog import show_log


def main() -> None:
    parser = argparse.ArgumentParser(prog="git mlogf", description=__doc__)
    add_branch_args(parser)
    args = parser.parse_args()

    show_log(args.branch, args.remote, stat=True)


if __name__ == "__main__":
    run_main(main)
