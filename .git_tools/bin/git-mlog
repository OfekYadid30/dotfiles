#!/usr/bin/env python3
"""git mlog [--branch BRANCH] [--stat]

Show the commits HEAD has ahead of origin/<branch> (default: master, or
`git config gitm.default-branch`). This is exactly `git log
origin/<branch>..HEAD` with a compact graph, i.e. "what would I be
pushing/merging".

Prints directly; only opens a pager if the output is taller than your
terminal (see gitm.pager -- this doesn't depend on your git/less config).
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from gitm.cli import add_branch_args, run_main
from gitm.mlog import show_log


def main() -> None:
    parser = argparse.ArgumentParser(prog="git mlog", description=__doc__)
    add_branch_args(parser)
    parser.add_argument("--stat", action="store_true", help="also show per-file diffstat")
    args = parser.parse_args()

    show_log(args.branch, args.remote, stat=args.stat)


if __name__ == "__main__":
    run_main(main)
