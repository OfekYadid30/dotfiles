{
  "$schema": "https://opencode.ai/config.json",
  // Everything is allowed, inside the project and outside it, except the bash
  // commands below, which ask first. Within "bash" the LAST matching pattern
  // wins, so "*": "allow" has to come first.
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow",
    "bash": {
      "*": "allow",

      // tmux kill-server
      "tmux kill-server*": "ask",
      "tmux *kill-server*": "ask",

      // removing files
      "rm": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "shred *": "ask",
      "trash *": "ask",
      "git rm*": "ask",
      "git clean*": "ask",
      "find * -delete*": "ask",
      "find * -exec rm*": "ask",
      "xargs rm*": "ask",
      "xargs *rm *": "ask",
      "sudo rm*": "ask",

      // git push, in any form
      "git push*": "ask",
      "git * push*": "ask",

      // killing processes
      "kill": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "xkill*": "ask",
      "sudo kill*": "ask",
      "sudo pkill*": "ask",
      "sudo killall*": "ask"
    }
  }
}
